{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aula-ai",
  "main": "./worker.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}